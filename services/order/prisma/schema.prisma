generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id             Int            @id @default(autoincrement())
  userId         Int            @map("user_id")
  status         String         @db.VarChar(20) // PENDING | PAID | SHIPPING | DELIVERED | CANCELLED | REFUNDED
  total          Int // VND
  refundedAmount Int            @default(0) @map("refunded_amount") // mirrored from Payment
  note           String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  items          OrderItem[]
  delivery       OrderDelivery?

  @@index([userId])
  @@map("orders")
}

/// Product name/price are copied at order time (no cross-DB join with product_db).
model OrderItem {
  id        Int    @id @default(autoincrement())
  orderId   Int    @map("order_id")
  productId Int    @map("product_id")
  name      String @db.VarChar(200)
  qty       Int
  price     Int
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

/// Price quote shown to the customer before an order is placed (docs/USECASES.md section 3b).
/// `id` is the short code the customer types to confirm; the Gateway checks it is in their own message.
model Quote {
  id             String   @id @db.VarChar(12)
  userId         Int      @map("user_id")
  items          Json // [{product_id, name, qty, price}]
  total          Int
  recipientName  String   @map("recipient_name") @db.VarChar(100)
  recipientPhone String   @map("recipient_phone") @db.VarChar(20)
  address        String
  expiresAt      DateTime @map("expires_at")
  orderId        Int?     @map("order_id") // set once the order is placed

  @@index([userId])
  @@map("quotes")
}

/// Where to ship an order; sent to Shipping when the order is paid. Seed orders have none.
model OrderDelivery {
  orderId        Int    @id @map("order_id")
  recipientName  String @map("recipient_name") @db.VarChar(100)
  recipientPhone String @map("recipient_phone") @db.VarChar(20)
  address        String
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_delivery")
}

/// Transactional outbox: gRPC calls to other services, committed with the change that caused them.
model OutboxMessage {
  id             Int      @id @default(autoincrement())
  target         String   @db.VarChar(30)
  method         String   @db.VarChar(60)
  payload        Json
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  status         String   @default("PENDING") @db.VarChar(10)
  attempts       Int      @default(0)
  lastError      String?  @map("last_error")
  createdAt      DateTime @default(now()) @map("created_at")
  nextAttemptAt  DateTime @default(now()) @map("next_attempt_at")

  @@index([status])
  @@map("outbox")
}
