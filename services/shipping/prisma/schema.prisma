generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shipment {
  id             Int             @id @default(autoincrement())
  orderId        Int             @unique @map("order_id")
  userId         Int             @map("user_id") // denormalized for ownership checks
  status         String          @db.VarChar(20) // WAITING_PICKUP | IN_TRANSIT | DELIVERED | CANCELLED
  carrier        String          @db.VarChar(50)
  trackingCode   String          @map("tracking_code") @db.VarChar(50)
  recipientName  String          @map("recipient_name") @db.VarChar(100)
  recipientPhone String          @map("recipient_phone") @db.VarChar(20)
  address        String
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  events         ShipmentEvent[]

  @@index([userId])
  @@map("shipments")
}

model ShipmentEvent {
  id          Int      @id @default(autoincrement())
  shipmentId  Int      @map("shipment_id")
  status      String   @db.VarChar(20)
  location    String   @db.VarChar(100)
  description String
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("shipment_events")
}

/// Transactional outbox: gRPC calls to other services, committed with the change that caused them.
model OutboxMessage {
  id             Int      @id @default(autoincrement())
  target         String   @db.VarChar(30)
  method         String   @db.VarChar(60)
  payload        Json
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  status         String   @default("PENDING") @db.VarChar(10)
  attempts       Int      @default(0)
  lastError      String?  @map("last_error")
  createdAt      DateTime @default(now()) @map("created_at")
  nextAttemptAt  DateTime @default(now()) @map("next_attempt_at")

  @@index([status])
  @@map("outbox")
}
